# Dockerfile.producer

FROM python:3.11-slim

# Çalışma dizini
WORKDIR /app

# Sistem bağımlılıklarını yükle
RUN apt-get update && \
    apt-get install -y --no-install-recommends build-essential && \
    rm -rf /var/lib/apt/lists/*

# Python bağımlılıklarını yükle
COPY hava-kirliligi-projesi/requirements.txt .
RUN pip install --upgrade pip setuptools wheel \
    && pip install --no-cache-dir --prefer-binary -r requirements.txt

# Producer script’inizi kopyalayın
COPY hava-kirliligi-projesi/app/rabbitmq_producer.py .

# Container başladığında bu script çalışacak
CMD ["python", "rabbitmq_producer.py"]
